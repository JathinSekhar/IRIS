# Copy to backend/.env and fill in. Never commit .env.

# Supabase: Project -> Connect -> "Direct connection" (use the Session pooler instead if your network has no IPv6).
# Percent-encode special characters in the password (@ becomes %40).
IRIS_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase Auth: Project Settings -> API. The anon / publishable key is public by design.
# NEVER put the service_role / secret key in this project.
IRIS_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
IRIS_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Where the web app is served (used in the links inside confirmation and reset emails).
IRIS_SITE_URL=http://localhost:5173

# Set to true when served over HTTPS (always, outside local development).
IRIS_COOKIE_SECURE=false
